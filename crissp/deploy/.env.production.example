# Every setting crissp/deploy.sh --cluster reads, without a value. Copy it to .env.production at the repository's root
# (never in git, never in an image), fill it in there, never here. deploy.json says which keys are secrets (into the
# chart's Secret), which are settings (into its ConfigMap), which are required and which rules they follow.

# secrets (cluster.env.secrets)
DB_PASSWORD=
APP_SECRET_KEY=
MAIL_PASSWORD=

# settings (cluster.env.settings)
MAIL_HOST=
MAIL_USER=
MAIL_FROM=

# the registry, for Terraform's image pull secret (cluster.env.registry); empty: Terraform makes no pull secret
REGISTRY_SERVER=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
