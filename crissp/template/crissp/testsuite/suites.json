{
 "$comment": "CRISSP: the parts of {{PRODUCT}}: what every run, crissp/check.sh's map and the dashboard are made of. By default the backend is app/backend, the frontend app/frontend, and docker-compose.yml at the root runs them together; a step exists once its part does (`when`); a parallel step spreads its tests over the workers this machine has. crissp/testsuite/lib/project.py says what each field means; python3 crissp/testsuite/lib/project.py check says what is wrong.",
 "product": "{{PRODUCT}}",
 "steps": [
  {"key": "backend", "label": "CRISSP: the backend's tests (pytest under coverage)", "dir": "app/backend",
   "run": "covered tests", "seconds": 20, "gate": true, "sources": ["app/backend"], "omit": ["*/tests/*"],
   "when": "app/backend", "parallel": true},
  {"key": "backend-lint", "label": "CRISSP: the backend's lint (ruff)", "dir": "app/backend",
   "run": "py -m ruff check --no-cache .", "seconds": 3, "when": "app/backend"},
  {"key": "frontend", "label": "CRISSP: the frontend's tests", "dir": "app/frontend", "run": "npm test",
   "seconds": 20, "when": "app/frontend/package.json"},
  {"key": "frontend-lint", "label": "CRISSP: the frontend's lint (the package's lint script)", "dir": "app/frontend",
   "run": "npm run --silent lint", "seconds": 5, "when": "app/frontend/package.json"},
  {"key": "audit", "label": "CRISSP: CVEs and misconfigurations (pip-audit, npm audit, trivy)", "run": "audit run",
   "seconds": 60, "full_only": true, "when": "app"}
 ],
 "paths": [
  {"match": "app/backend/", "steps": ["backend", "backend-lint"]},
  {"match": "app/frontend/", "steps": ["frontend", "frontend-lint"]}
 ],
 "shared": [
  {"match": "docker-compose.yml", "why": "how the parts run together"},
  {"match": "*/Dockerfile", "why": "what goes into an image"},
  {"match": "*/requirements.txt", "why": "the dependencies"},
  {"match": "*/package-lock.json", "why": "the frontend's dependencies"}
 ],
 "notes": [],
 "setup": {"venvs": [], "npm": [], "needs": []},
 "audit": {"missing": "skip", "pip": ["app/backend/requirements.txt"], "npm": ["app/frontend"],
           "fs": ["app/backend", "app/frontend"], "dockerfiles": ["app/*/Dockerfile"],
           "config": ["crissp/deploy/helm/app", "crissp/deploy/terraform"],
           "images": ["docker-compose.yml", "crissp/deploy/helm/app/values.yaml"],
           "own_images": {"values": "crissp/deploy/helm/app/values.yaml", "parts": ["backend", "frontend"]}},
 "texts": {}
}
