{
 "$comment": "This repository's parts: the framework itself is the product (lib/project.py says what each field means).",
 "product": "C.R.I.S.S.P.",
 "monogram": "C",
 "steps": [
  {
   "key": "tools",
   "label": "The framework's own tests (testsuite, uxsuite, crissp tool)",
   "dir": "crissp/testsuite",
   "run": "covered tests ../uxsuite/tests",
   "seconds": 40,
   "gate": true,
   "sources": [
    "crissp/testsuite/lib",
    "crissp/tool",
    "crissp/uxsuite",
    "crissp/testsuite/lint"
   ],
   "omit": [
    "*/tests/*"
   ],
   "fail_under": 100,
   "tests": [
    "crissp/testsuite/tests",
    "crissp/uxsuite/tests"
   ],
   "parallel": true
  },
  {
   "key": "python-lint",
   "label": "Lint of crissp's own Python (ruff with pyproject.toml's rules, standard library only, no duplicate code)",
   "dir": ".",
   "run": "py crissp/testsuite/lint/python_lint.py",
   "seconds": 5,
   "tests": []
  },
  {
   "key": "deploy",
   "label": "Deploy template (helm lint and template, Terraform, its tests)",
   "dir": ".",
   "run": "crissp/deploy/check.sh",
   "seconds": 30,
   "when": "crissp/deploy/check.sh",
   "tests": [
    "crissp/deploy/tests"
   ]
  },
  {
   "key": "lint",
   "label": "Lint: shellcheck on the bash scripts, ESLint on the JavaScript",
   "dir": ".",
   "run": "crissp/testsuite/lint/lint.sh",
   "seconds": 10,
   "tests": []
  },
  {
   "key": "package",
   "label": "The package: build, install, init a project, its full run",
   "dir": ".",
   "run": "uv run --quiet --no-project --with-requirements crissp/testsuite/requirements.txt python -m pytest -q -p no:cacheprovider --junitxml=\"$JUNIT\" crissp/testsuite/package_tests",
   "seconds": 30,
   "tests": [
    "crissp/testsuite/package_tests"
   ]
  },
  {
   "key": "secrets",
   "label": "Secrets in the git history (gitleaks)",
   "dir": "crissp/testsuite",
   "run": "python3 lib/audit.py secrets",
   "seconds": 5
  },
  {
   "key": "sast",
   "label": "Unsafe code (Semgrep with crissp's rules, and the rules' own tests)",
   "dir": "crissp/testsuite",
   "run": "python3 lib/audit.py rules && python3 lib/audit.py sast",
   "seconds": 15
  },
  {
   "key": "audit",
   "label": "CVE audit of the pinned test tools (pip-audit)",
   "dir": "crissp/testsuite",
   "run": "python3 lib/audit.py run",
   "seconds": 60,
   "full_only": true
  }
 ],
 "paths": [
  {
   "match": "crissp/testsuite/accepted-risks.json",
   "steps": [
    "audit",
    "secrets"
   ]
  },
  {
   "match": "crissp/testsuite/lint/python_lint.py",
   "steps": [
    "tools",
    "python-lint",
    "secrets",
    "sast"
   ]
  },
  {
   "match": "crissp/testsuite/lint/requirements.txt",
   "steps": [
    "lint",
    "python-lint",
    "secrets"
   ]
  },
  {
   "match": "crissp/testsuite/lint/",
   "steps": [
    "lint",
    "secrets"
   ]
  },
  {
